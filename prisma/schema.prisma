datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  password String
  isSuperAdmin Boolean @default(false)
  subscriptionStatus String @default("TRIAL")
  trialEndsAt DateTime @default(dbgenerated("NOW() + INTERVAL '14 days'"))
  createdAt DateTime @default(now())
  autopilotMode String @default("OFF")
  aiPermissions Json @default("{\"canReply\": true, \"canQualify\": true, \"canFollowUp\": true, \"canBook\": false}")
  businessName String?
  leads Lead[]
  knowledgeSources KnowledgeSource[]
  automations Automation[]
  aiActions AIAction[]
}

model Lead {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  name String
  phone String
  email String?
  company String?
  language String @default("en")
  source String @default("WHATSAPP")
  stage String @default("NEW")
  score Int @default(0)
  temperature String @default("COLD")
  intent String @default("LOW")
  sentiment String @default("NEUTRAL")
  dealValue Float @default(0)
  dealProbability Float @default(0)
  channels String[] @default(["WHATSAPP"])
  createdAt DateTime @default(now())
  lastContactAt DateTime @default(now())
  memories LeadMemory[]
  conversations Conversation[]
  appointments Appointment[]
  calls Call[]
  deals Deal[]
  actions AIAction[]
  @@index([userId, stage])
}

model LeadMemory {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type String
  content String
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
}

model Conversation {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel String
  role String
  content String
  intent String?
  buyingSignal Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
}

model KnowledgeSource {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  name String
  type String
  status String @default("PROCESSING")
  content String?
  createdAt DateTime @default(now())
  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id String @id @default(cuid())
  sourceId String
  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content String
}

model Automation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  name String
  trigger String
  status String @default("ACTIVE")
  steps Json
  createdAt DateTime @default(now())
  executions AutomationExecution[]
}

model AutomationExecution {
  id String @id @default(cuid())
  automationId String
  automation Automation @relation(fields: [automationId], references: [id])
  leadId String
  status String @default("QUEUED")
  log Json?
  createdAt DateTime @default(now())
}

model AIAction {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  leadId String
  lead Lead @relation(fields: [leadId], references: [id])
  action String
  reason String
  confidence Float
  status String @default("PENDING_APPROVAL")
  result String?
  createdAt DateTime @default(now())
}

model Appointment {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id])
  title String
  status String @default("BOOKED")
  startTime DateTime
  endTime DateTime
  createdAt DateTime @default(now())
}

model Call {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id])
  status String
  duration Int @default(0)
  summary String?
  createdAt DateTime @default(now())
}

model Deal {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id])
  value Float
  currency String @default("USD")
  stage String
  probability Float
  isAiInfluenced Boolean @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())
  userId String
  action String
  entity String
  entityId String
  details Json?
  createdAt DateTime @default(now())
}
